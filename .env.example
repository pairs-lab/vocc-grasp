# Copy to .env (git-ignored) and fill in. Everything reads these from the environment;
# no key is ever hardcoded.
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional throttling for free-tier keys
# GEMINI_REQUEST_DELAY_SECONDS=0
# GEMINI_HTTP_TIMEOUT_MS=60000
